<mvc:View 
    controllerName="project1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page  title="My To-DoList">
        <Table 
                id="SalesorederTable"
                items="{SalesOrder>/SalesOrderSet}">

            <columns>

                <Column>
                    <Text text="Sales Document"/>
                </Column>

                <Column>
                    <Text text="Created date"/>
                </Column>

            </columns>

            <items>

                <ColumnListItem>

                    <cells>

    
                        <Text text="{SalesOrder>VBELN}"/>

                        <Text text="{SalesOrder>ERDAT}"/>

                     </cells>

                </ColumnListItem>

            </items>

        </Table>

