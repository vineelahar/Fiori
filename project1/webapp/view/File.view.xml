<mvc:View controllerName="project1.controller.File"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">

    <Button
        text="Download BOM File"
        icon="sap-icon://download"
        press=".onDownloadBOMTemplate"
        type="Emphasized" />

    <Button
