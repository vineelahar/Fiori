                        </Column>
                        <Column >
                            <Text text="CompanyName"/>
                        </Column>
                        <Column >
                            <Text text="City"/>
                        </Column>
                    </columns>
                

                    <items>
                        <ColumnListItem >
                            <cells>
                                <Text text="{CustomerID}"/>
                                <Text text="{CustomerName}"/>
                                <Text text="{City}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table> -->
                <smartTable:SmartTable
                    id="customerSmartTable"
                    entitySet="Customers"
                    smartFilterId="customerFilterBar"
                    tableType="ResponsiveTable"
                    header="Customer Information"
                    enableAutoBinding="true"
                    useVariantManagement="true"
                    useTablePersonalisation="true"
                    persistencyKey="CustomerTableVariant"
                    initiallyVisibleFields="CustomerID,CompanyName,City,Country,PostalCode"/>

            </VBox>
        </content>

