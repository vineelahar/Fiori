<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    controllerName="project3.controller.SmartTable"
    height="100%">

    <Page title="Northwind Customers">
        <content>
            <VBox fitContainer="true">
                 <!-- <Button
                    text="Open Customer Dialog"
                    press=".onOpenCustomerDialog"/> -->

                <smartFilterBar:SmartFilterBar
                    id="customerFilterBar"
                    entitySet="Customers"
                    persistencyKey="CustomerFilter"
                    showFilterConfiguration="true">

                    <smartFilterBar:controlConfiguration>
                        <smartFilterBar:ControlConfiguration
                            key="CustomerID"
                            visibleInAdvancedArea="true"
                            filterType="multi-value"
                            hasValueHelpDialog="false"
                            index="0">

                            <smartFilterBar:customControl>
                                <MultiInput
                                    id="customerIdInput"
                                    showValueHelp="true"
                                    valueHelpRequest=".onOpenCustomerValueHelp"/>
                            </smartFilterBar:customControl>

                        </smartFilterBar:ControlConfiguration>

                        <smartFilterBar:ControlConfiguration
                            key="CompanyName"
                            visibleInAdvancedArea="true"
                            index="1"/>

                        <smartFilterBar:ControlConfiguration
                            key="City"
                            visibleInAdvancedArea="true"
                            index="2"/>

                        <smartFilterBar:ControlConfiguration
                            key="PostalCode"
                            visibleInAdvancedArea="true"
                            index="3"/>
                    </smartFilterBar:controlConfiguration>
                </smartFilterBar:SmartFilterBar>
                <!-- <Table id="customerSelectionTable"
                        mode="MultiSelect"
                        items="{/Customers}">
                    <columns>
                        <Column >
