        <detailPages>

            <!-- Customer Table Page -->
            <Page id="customerTablePage" title="Customer Table">
                <content>
                    <Table
                        id="customerTable"
                        items="{/Customers}"
                        mode="SingleSelectMaster"
                        selectionChange=".onCustomerSelect">

                        <columns>
                            <Column>
                                <Text text="Customer ID" />
                            </Column>
                            <Column>
                                <Text text="Company Name" />
                            </Column>
                            <Column>
                                <Text text="City" />
                            </Column>
                        </columns>

                        <items>
                            <ColumnListItem>
                                <cells>
                                    <Text text="{CustomerID}" />
                                    <Text text="{CompanyName}" />
                                    <Text text="{City}" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </content>
            </Page>

            <!-- Customer Details Page -->
            <Page id="customerDetailsPage" title="Customer Details">
                <content>
                    <VBox class="sapUiMediumMargin" gap="0.5rem">

                        <Label text="Customer ID" />
                        <Text text="{selectedCustomer>/CustomerID}" />

                        <Label text="Customer Name" />
                        <Text text="{selectedCustomer>/CompanyName}" />

                        <Label text="Contact Name" />
                        <Text text="{selectedCustomer>/ContactName}" />

                        <Label text="Address" />
                        <Text text="{selectedCustomer>/Address}" />

                        <Label text="City" />
                        <Text text="{selectedCustomer>/City}" />

                        <Label text="Country" />
                        <Text text="{selectedCustomer>/Country}" />

                        <Label text="Phone" />
                        <Text text="{selectedCustomer>/Phone}" />

                    </VBox>
                </content>
            </Page>

        </detailPages>


    </SplitApp>



</mvc:View>
