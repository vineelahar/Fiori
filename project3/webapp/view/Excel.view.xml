<mvc:View
    controllerName="project1.controller.Excel"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable">

    <Page
        id="page"
        title="Excel Table">
        
        <content>
           
            <smartTable:SmartTable
                id="ExccelTable"
                entitySet="ExcelheadSet"
                tableType="Table"
                
                useVariantManagement="true"
                useTablePersonalisation="true"
                header="Excel Details"
                enableAutoBinding="true" 
                initiallyVisibleFields="Product,ProductType,Brand,BaseUnit,CreatedByUser"/>
        </content>

    </Page>
</mvc:View>