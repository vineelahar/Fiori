{
  "_version": "1.89.0",
  "sap.app": {
    "id": "project2",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.32.0",
      "toolsId": "a0013c88-8152-4590-8934-3147ea6c889c"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "project2.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "project2.view",
        "async": true,
        "viewPath": "project2.view"
      },
      "routes": [
        {
          "name": "RouteView1",
          "pattern": ":?query:",
          "target": [
            "TargetView1"
          ]
        },
        {
          "name": "RouteTable",
          "pattern": "table",
          "target": [
            "TargetTable"
          ]
        },
        {
          "name": "RouteCustomermaster",
          "pattern": "Customermaster",
          "target": [
            "TargetCustomermaster"
          ]
        },
        {
          "name": "RouteUploadfile",
          "pattern": "Uploadfile",
          "target": [
            "TargetUploadfile"
          ]
        },
        {
          "name": "RouteActionsheet",
          "pattern": "Actionsheet",
          "target": [
            "TargetActionsheet"
          ]
        },
        {
          "name": "RoutePdfembedded",
          "pattern": "Pdfembedded",
          "target": [
            "TargetPdfembedded"
          ]
        },
        {
          "name": "RoutePdfpopup",
          "pattern": "Pdfpopup",
          "target": [
            "TargetPdfpopup"
          ]
        },
        {
          "name": "RoutePdftwo",
          "pattern": "Pdftwo",
          "target": [
            "TargetPdftwo"
          ]
        },
        {
          "name": "RouteTile",
          "pattern": "Tile",
          "target": [
            "TargetTile"
          ]
        },
        {
          "name": "RouteProject1",
          "pattern": "Project1/{tile}",
          "target": [
            "TargetProject1"
          ]
        },
        {
          "name": "RouteExcel",
          "pattern": "Excel",
          "target": [
            "TargetExcel"
          ]
        },
        {
          "name": "RouteExceltable",
          "pattern": "Exceltable",
          "target": [
            "TargetExceltable"
          ]
        },
        {
          "name": "RouteDynamic",
          "pattern": "Dynamic",
          "target": [
            "TargetDynamic"
          ]
        },
        {
          "name": "RouteDynamicfilter",
          "pattern": "Dynamicfilter",
          "target": [
            "TargetDynamicfilter"
          ]
        }
      ],
      "targets": {
        "TargetView1": {
          "id": "View1",
          "name": "View1"
        },
        "TargetTable": {
          "id": "Table",
          "name": "Table"
        },
        "TargetCustomermaster": {
          "id": "Customermaster",
          "name": "Customermaster"
        },
        "TargetUploadfile": {
          "id": "Uploadfile",
          "name": "Uploadfile"
        },
        "TargetActionsheet": {
          "id": "Actionsheet",
          "name": "Actionsheet"
        },
        "TargetPdfembedded": {
          "id": "Pdfembedded",
          "name": "Pdfembedded"
        },
        "TargetPdfpopup": {
          "id": "Pdfpopup",
          "name": "Pdfpopup"
        },
        "TargetPdftwo": {
          "id": "Pdftwo",
          "name": "Pdftwo"
        },
        "TargetTile": {
          "id": "Tile",
          "name": "Tile"
        },
        "TargetProject1": {
          "id": "Project1",
          "name": "Project1"
        },
        "TargetExcel": {
          "id": "Excel",
          "name": "Excel"
        },
        "TargetExceltable": {
          "id": "Exceltable",
          "name": "Exceltable"
        },
        "TargetDynamic": {
          "id": "Dynamic",
          "name": "Dynamic"
        },
        "TargetDynamicfilter": {
          "id": "Dynamicfilter",
          "name": "Dynamicfilter"
        }
      }
    },
    "rootView": {
      "viewName": "project2.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "project2"
  }
}
